# ============================================================
# ОБЯЗАТЕЛЬНЫЕ
# ============================================================
MONGODB_URI=mongodb://127.0.0.1:27017/cinephilium
JWT_ACCESS_SECRET=replace-me-access
JWT_REFRESH_SECRET=replace-me-refresh
TMDB_API_KEY=replace-me
ADMIN_SECRET_KEY=replace-me

# ============================================================
# ТОКЕНЫ И COOKIE
# ============================================================
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# В production: COOKIE_SECURE=true (нужен HTTPS).
# COOKIE_DOMAIN оставь пустым — host-only cookie работает и локально, и на домене.
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ============================================================
# АДРЕСА
# ============================================================
# Список origin через запятую, без пробелов
CORS_ORIGIN=http://localhost:3000
# Адрес ФРОНТЕНДА: из него собирается ссылка сброса пароля
CLIENT_URL=http://localhost:3000
# НЕОБЯЗАТЕЛЬНО. Адрес БЭКЕНДА, к которому клеится /api/tmdb-image.
# Пусто (рекомендуется) — база прокси берётся из origin входящего запроса.
# Сюда нельзя писать домен фронтенда: /api/tmdb-image там не существует,
# и постеры превратятся в заглушки.
IMAGE_PROXY_BASE_URL=

# ============================================================
# ДОВЕРИЕ К ПРОКСИ (лимиты по IP)
# ============================================================
# Сети СВОИХ reverse-proxy через запятую, от которых принимается заголовок
# x-real-ip. Пусто (рекомендуется) — заголовку не верим никому, лимиты считаются
# по адресу соединения req.ip. Нужно только если перед бэкендом стоит свой nginx,
# который подставляет x-real-ip: тогда впиши его сети, например 10.0.0.0/8.
# Cloudflare опознаётся автоматически по req.ip (список сетей в коде), настраивать
# ничего не нужно. Сети, вписанные сюда, обязаны быть недоступны клиентам —
# иначе подделка x-real-ip снова откроет обход лимитов (C-2).
TRUSTED_PROXY_CIDRS=

# ============================================================
# РЕГИСТРАЦИЯ БЕЗ ПОЧТЫ
# ============================================================
# invite — аккаунт создаётся только по одноразовому коду от админа (по умолчанию);
# open   — свободная регистрация, если когда-нибудь откроешь её всем.
REGISTRATION_MODE=invite
# Срок жизни выданного инвайта в днях. 0 — бессрочно.
INVITE_TTL_DAYS=0
# Сколько минут живёт ссылка сброса пароля, которую выдаёт админ.
PASSWORD_RESET_TTL_MIN=30

# ============================================================
# СВЯЗЬ С АДМИНАМИ
# ============================================================
# Телеграмы для страницы «Связь с админами», через запятую, без @.
ADMIN_TELEGRAMS=
