# ============================================================
# ОБЯЗАТЕЛЬНЫЕ
# ============================================================
MONGODB_URI=mongodb://127.0.0.1:27017/cinephilium
JWT_ACCESS_SECRET=replace-me-access
JWT_REFRESH_SECRET=replace-me-refresh
TMDB_API_KEY=replace-me
ADMIN_SECRET_KEY=replace-me

# ============================================================
# ТОКЕНЫ И COOKIE
# ============================================================
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# В production: COOKIE_SECURE=true (нужен HTTPS).
# COOKIE_DOMAIN оставь пустым — host-only cookie работает и локально, и на домене.
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ============================================================
# АДРЕСА
# ============================================================
# Список origin через запятую, без пробелов
CORS_ORIGIN=http://localhost:3000
# База для ссылки сброса пароля — адрес ФРОНТЕНДА
CLIENT_URL=http://localhost:5173
# Если задан, постеры идут через /api/tmdb-image
IMAGE_PROXY_BASE_URL=http://localhost:3000

# ============================================================
# ПОЧТА (SMTP)
# Без этих переменных письма НЕ отправляются:
#   - в dev код/ссылка печатаются в консоль сервера;
#   - в production в логах будет EMAIL_SEND_FAILED.
# ============================================================
# Примеры:
#   Яндекс:   smtp.yandex.ru          465, secure=true
#   Brevo:    smtp-relay.brevo.com    587, secure=false
#   SendGrid: smtp.sendgrid.net       587, secure=false (SMTP_USER=apikey)
#   Resend:   smtp.resend.com         587, secure=false (SMTP_USER=resend)
SMTP_HOST=
# 465 → SMTP_SECURE=true, 587 → SMTP_SECURE=false
SMTP_PORT=587
SMTP_SECURE=false
# Логин и «пароль приложения» (не пароль от аккаунта!)
SMTP_USER=
SMTP_PASS=
# Отправитель. Лучше ASCII-имя и домен, подтверждённый у провайдера.
SMTP_FROM=Cinephilium <noreply@example.com>
EMAIL_CODE_TTL_MIN=10
EMAIL_RESEND_COOLDOWN_SEC=60
EMAIL_RESEND_MAX_PER_HOUR=3
